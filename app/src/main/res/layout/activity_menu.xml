<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#3E2723">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="中国象棋"
        android:textColor="#FFE0B2"
        android:textSize="48sp"
        android:textStyle="bold"
        android:paddingBottom="30dp" />

    <TextView
        android:id="@+id/tv_strength"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="当前强度：初级"
        android:textColor="#FFB300"
        android:textSize="26sp"
        android:textStyle="bold"
        android:paddingBottom="16dp" />

    <TextView
        android:id="@+id/tv_stats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="战绩：0 场 · 胜 0 / 负 0 / 和 0 · 胜率 —"
        android:textColor="#FFE0B2"
        android:textSize="20sp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.4"
        android:paddingBottom="40dp" />

    <Button
        android:id="@+id/btn_menu_start"
        android:layout_width="320dp"
        android:layout_height="72dp"
        android:layout_marginVertical="8dp"
        android:nextFocusDown="@id/btn_menu_aifirst"
        android:text="开始游戏"
        android:textSize="22sp" />

    <Button
        android:id="@+id/btn_menu_aifirst"
        android:layout_width="320dp"
        android:layout_height="56dp"
        android:layout_marginVertical="8dp"
        android:nextFocusUp="@id/btn_menu_start"
        android:nextFocusDown="@id/btn_menu_voice"
        android:text="刘洪江执红先行：关"
        android:textSize="18sp" />

    <Button
        android:id="@+id/btn_menu_voice"
        android:layout_width="320dp"
        android:layout_height="56dp"
        android:layout_marginVertical="8dp"
        android:nextFocusUp="@id/btn_menu_aifirst"
        android:text="语音：开"
        android:textSize="18sp" />

</LinearLayout>
